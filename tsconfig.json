{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],  // Ensure Vite types are included
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx"  // Add this line to handle JSX files correctly
  },
  "include": ["src/**/*", "vite.config.ts"],  // Include vite.config.ts
  "exclude": ["node_modules"]
}

